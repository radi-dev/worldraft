{
  "name": "worldraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/studio"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:check": "node scripts/setup.mjs --check",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @worldraft/studio",
    "package": "node scripts/package.mjs",
    "typecheck": "npm run typecheck --workspace @worldraft/studio",
    "test": "npm run test:offline",
    "test:offline": "npm run test:unit:js && npm run test:unit:python",
    "test:unit:js": "node --import ./scripts/offline-network.mjs --test scripts/setup.test.mjs scripts/package.test.mjs scripts/dev.test.mjs scripts/offline-network.test.mjs",
    "test:unit:python": "uv run --project backend --no-sync --offline python backend/tests/run_offline.py",
    "test:integration": "node --test scripts/dev.integration.test.mjs",
    "test:backend": "npm run test:unit:python"
  }
}
