# Worldraft configuration template. Copy to `.env` in this same folder.
# `.env` is git-ignored and is never included in a release zip.
#
# WHO READS WHAT
#   The application (backend)      reads WORLDRAFT_* from the environment AND from this file.
#                                  If both set the same name, the environment wins.
#   The developer launcher         reads API_PORT, UI_PORT, NO_OPEN, DEV_STARTUP_TIMEOUT_MS, BROWSER
#   (`npm run dev`)                from the environment ONLY. Putting them in this file does nothing.
#   The frontend build             reads VITE_API_URL from the environment ONLY, at build time.
#
# ---- Application settings (backend/src/studio/settings.py) ----------------
WORLDRAFT_PORT=8000                  # user mode (start.sh / start.cmd): port of the single server
# WORLDRAFT_UI_DIR=apps/studio/dist  # user mode: folder with the built UI
# WORLDRAFT_CORS_ORIGINS=            # split deployment only, e.g. https://studio.example.com
WORLDRAFT_LOG_LEVEL=info
#
# ---- Developer launcher: environment variables only, shown for reference --
#   API_PORT=8010 UI_PORT=5180 npm run dev      (macOS/Linux)
#   $env:API_PORT=8010; npm run dev             (Windows PowerShell)
# ---- Frontend build (split deployment only) --------------------------------
#   VITE_API_URL=https://api.example.com npm run build
